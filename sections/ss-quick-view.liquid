{% liquid
  assign variant = product.first_available_variant
  assign compare_at_price = variant.compare_at_price
  assign price = variant.price | default: product.price
  assign available = variant.available | default: false
  assign money_price = price | money

  if product.price_varies
    assign money_price = 'products.product.price.from_price_html' | t: price: money_price
  endif
%}

<div class="quick-view">
  <div class="quick-view-dialog__product-info">
    <div class="quick-view-dialog__image">
      {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
    </div>
    <div class="quick-view-dialog__col">
      <h2 class="product__title">{{ product.title | escape }}</h2>

      <div class="price__sale">
        {% if compare_at_price > price %}
          <span class="visually-hidden visually-hidden--inline">
            {{- 'products.product.price.regular_price' | t -}}
          </span>
          <span>
            <s class="price-item price-item--regular">
              {% if settings.currency_code_enabled %}
                {{ compare_at_price | money_with_currency }}
              {% else %}
                {{ compare_at_price | money }}
              {% endif %}
            </s>
          </span>
        {% endif %}

        <span class="visually-hidden visually-hidden--inline">
          {{ 'products.product.price.sale_price' | t }}
        </span>
        <span class="price-item price-item--sale price-item--last">
          {{ money_price }}
        </span>
      </div>

      {% unless available %}
        <p class="product__sold-out">{{ 'products.product.sold_out' | t }}</p>
      {% endunless %}

      {%- if product.description != blank -%}
        <div class="product__description rte quick-add-hidden">
          {{ product.description }}
        </div>
      {%- endif -%}
    </div>
  </div>

  {% render 'ss-variant-picker', product: product, variant: variant, section: section %}

  <div class="buy-buttons">
    <button class="cta" type="button" data-atc>Add to Cart {{ 'icon-arrow-right.svg' | inline_asset_content }}</button>
  </div>
</div>
