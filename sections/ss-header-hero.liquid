{% comment %} 
    Header Hero
{% endcomment %}

{% style %}
    #shopify-section-{{ section.id }}{
        font-family: 'Jost', sans-serif;
        font-size: 16px;
        letter-spacing: 0;
        color: {{ section.settings.text_color }};
    }
    .custom-header{
        display: flex;
        align-items:center;
        justify-content: space-between;
        padding: 10px 50px;
        Background: {{ section.settings.bg_color }};
    }
    .desktop-only{
        display:none;
    }


    /* DESKTOP */
    @media screen and (min-width: 990px){
        .mobile-only{
            display:none;
        }
        .desktop-only{
            display: unset; 
        }
    }
{% endstyle %}

<!-- Header -->
<header class="custom-header">

    <!-- Mobile Menu -->
    <details class="main-menu__disclosure mobile-only">
        <summary class="main-menu__toggle-icon">
            <span class="icon-menu">{{ 'icon-menu-hamburger.svg' | inline_asset_content }}</span>
            <span class="icon-close">{{ 'icon-menu-close.svg' | inline_asset_content }}</span>
        </summary>
    </details>

    <!-- Desktop Menu -->
    <a href="{{ section.settings.logo_url }}" class="custom-header__logo">
        {% if section.settings.logo_type == "logo" %}
            {{ section.settings.logo_image | image_url: width: 150 | image_tag  }}
        {% else %}
            {{ section.settings.logo_text | escape | default: "Logo Text" }}
        {% endif %}
    </a>

    <div class="custom-header__center desktop-only">
        {% comment %} Menu Can be here {% endcomment %}
         <p>{{ section.settings.tagline }}</p>
    </div>

    <div class="custom-header__buttons desktop-only">
        {% comment %} Buttons or login icons {% endcomment %}
         <a href="{{ section.settings.header_cta_link }}">
            {{ section.settings.header_cta_label | escape }}
            <span class="icon">{{ 'icon-arrow-right.svg' | inline_asset_content }}</span>
        </a>
    </div>

</header>


{% schema %}
{
    "name": "SS Header Hero",
    "tag": "section",
    "class": "section cc-header-hero",
    "presets": [{"name": "SS Header Banner", "category": "Ecommexperts Hiring Test"}],
    "settings": [
        {"type": "header", "content": "Top bar"},
        {
            "type": "select", "label": "Logo type", "id": "logo_type",
            "options": [{"label": "Logo", "value": "logo"}, {"label": "Text", "value": "text"}],
            "default": "logo"
        },
        {"type": "image_picker", "label": "Logo image", "id": "logo_image", "visible_if": "{{ section.settings.logo_type == 'logo' }}"},
        {"type": "text", "label": "Logo text", "id": "logo_text", "visible_if": "{{ section.settings.logo_type == 'text' }}", "default": "Tisso Vision"},
        {"type": "url", "label": "Logo link", "id": "logo_url"},
        {"type": "text", "label": "Center tagline", "id": "tagline", "default": "Find the ideal gift for your loved ones."},
        {"type": "text", "label": "Button label", "id": "header_cta_label", "default": "Choose Gift"},
        {"type": "url", "label": "Button link", "id": "header_cta_link"},

        {"type": "header", "content": "Hero image/content"},
        {"type": "image_picker", "label": "Desktop Image", "id": "desktop_image"},
        {"type": "image_picker", "label": "Mobile Image", "id": "mobile_image"},

        {"type": "paragraph", "content": "Overlay content for hero"},
        {"type": "text", "label": "Heading", "id": "hero_heading", "default": "The Gift Guide"},
        {"type": "textarea", "label": "Description", "id": "hero_description", "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."},
        {"type": "text", "label": "Button label", "id": "hero_cta_label", "default": "Shop Now"},
        {"type": "url", "label": "Button link", "id": "hero_cta_link"},

        {"type": "header", "content": "Footer strip"},
        {"type": "textarea", "label": "Strip text", "id": "footer_text", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"},


        {"type": "header", "content": "Colors"},
        {"type": "color", "label": "Text color", "id": "text_color", "default": "#000000"},
        {"type": "color", "label": "Background color", "id": "bg_color", "default": "#F5F5F5"},
        
    ]

}
{% endschema %}