{{ 'ss-hotspot-grid.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{section.id }}{
    padding-top: 33px;
    padding-bottom: 27px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{section.id }} {
      padding-top: 44px;
      padding-bottom: 36px;
    }
  }
{% endstyle %}

<hotspot-grid>
  <div class="page-width">
    {% if section.settings.heading != blank or section.settings.sub_heading != blank %}
      <div class="collection__title title-wrapper title-wrapper--no-top-margin align-{{ section.settings.heading_align }}">
        {% if section.settings.heading != blank %}
          <h2 class="title h2">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.sub_heading != blank %}
          <p>{{ section.settings.sub_heading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="hotspot-collection-grid">
      {% for block in section.blocks %}
        <div class="hotspot-collection-grid__item" data-index="{{ forloop.index }}" {{ block.shopify_attributes }}>
          {% if block.settings.product != blank %}
            {% assign product = block.settings.product %}
            <div class="hotspot-collection-grid__media-wrapper">
              {{ product.featured_image | image_url: width: 800 | image_tag }}
              <button
                data-hotspot-tracker
                class="hotspot-collection-grid__tracker"
                style="top: {{ block.settings.top }}%; left: {{ block.settings.left }}%"
                data-handle="{{ product.handle }}"
              >
                {{ 'icon-hotspot.svg' | inline_asset_content }}
              </button>
            </div>
          {% else %}
            <div class="hotspot-collection-grid__media-wrapper">
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% comment %}
                <button data-hotspot-tracker class="hotspot-collection-grid__tracker" style="top: {{ block.settings.top }}%; left: {{ block.settings.left }}%">
                  {{ "icon-hotspot.svg" | inline_asset_content }}
                </button>
              {% endcomment %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

  <dialog class="quick-view-dialog" id="quick-view-dialog-{{ section.id }}" aria-label="View Product" aria-modal="true">
    <button class="quick-view-dialog__close">{{ 'icon-close.svg' | inline_asset_content }}</button>
    <div class="quick-view-dialog__content">
       <div class="quick-view-dialog__content__loading__spinner loading__spinner">
        {{ 'loading-spinner.svg' | inline_asset_content }}
      </div>
    </div>
  </dialog>
</hotspot-grid>

<script>
  if (!customElements.get('hotspot-grid')) {
    customElements.define(
      'hotspot-grid',
      class HotspotGrid extends HTMLElement {
        constructor() {
          super();

          this.dialog = this.querySelector('dialog');
          this.btns = this.querySelectorAll('.hotspot-collection-grid__tracker');
          this.closeDialog = this.querySelector('.quick-view-dialog__close');
        }

        connectedCallback() {
          this.btns.forEach((btn) => {
            btn.addEventListener('click', this.open.bind(this, btn));
          });

          this.closeDialog.addEventListener('click', this.close.bind(this));
        }

        async open(btn) {
          this.dialog.showModal();
          const quickViewMarkup = await this.getMarkup(`/products/${btn.dataset.handle}?sections=ss-quick-view`);
        }

        close() {
          this.dialog.close();
        }

        async getMarkup(uri){
          try{
            const res = await fetch(uri); 
            console.log(res)
          }catch(e){
            console.error("something wrong with quickview", e)
          }
        }
      }
    );
  }
</script>

{% schema %}
{
  "name": "SS Hotspot Grid",
  "tag": "section",
  "class": "section cc-hotspot-grid",
  "presets": [
    {
      "name": "SS Hotspot Grid",
      "category": "Ecommexperts Hiring Test",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ],
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "label": "Heading", "id": "heading", "default": "Tisso vison in the wild" },
    { "type": "textarea", "label": "Sub heading", "id": "sub_heading" },
    {
      "type": "select",
      "label": "Heading alignment",
      "id": "heading_align",
      "options": [
        { "label": "Left", "value": "start" },
        { "label": "Center", "value": "center" },
        { "label": "Right", "value": "end" }
      ],
      "default": "start"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Product",
      "limit": 6,
      "settings": [
        { "type": "product", "id": "product", "label": "Select product" },
        { "type": "header", "content": "Hotspot position" },
        {
          "type": "range",
          "id": "top",
          "label": "Vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "left",
          "label": "Horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50,
          "unit": "%"
        }
      ]
    }
  ]
}
{% endschema %}
