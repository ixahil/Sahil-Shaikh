<ss-variant-picker>
  {% for option in product.options_with_values %}
    <fieldset class="js product-form__input product-form__input--pill">
      <legend class="form__label">
        {{ option.name }}:
        <span data-selected-value>
          {{- option.selected_value -}}
        </span>
      </legend>
      {% render 'product-variant-options', product: product, option: option, block: block, picker_type: picker_type %}
    </fieldset>
  {% endfor %}
</ss-variant-picker>

<script>
  if(!customElements.get("ss-variant-picker")){
  customElements.define("ss-variant-picker"
      class SSVariantPicker extends HTMLElement{
          constructor(){
              super();
          }
      })
  }
</script>
