{% comment %} Can take constance from the global settings to merchant can decide {% endcomment %}
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign size_option_names = 'size,Size,sizes,Sizes' | split: ','
  assign color_option_names = 'color,Color,colors,Colors,colour,Colour,colours,Colours' | split: ','
-%}
{%- capture label_unavailable -%}
  <span class="visually-hidden label-unavailable">
    {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
  </span>
{%- endcapture -%}
<ss-variant-picker>
  {% for option in product.options %}
    {{ option | json }}
    {% if size_option_names contains option.name %}
      {% capture size_variant_markup %}
        {%- capture input_id -%}
          {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
        {%- endcapture -%}
        {%- capture input_name -%}
          {{ option.name }}-{{ option.position }}
        {%- endcapture -%}
        <div class="size-select">
          <span class="size-select__selected">Choose your size</span>
          <ul class="size-select__list">
          {% for value in option.values %}
            <li class="size-select__list-item" data-value="{{ value }}">{{ value | escape }}</li>
          {% endfor %}
          </ul>
        </div>
        <fieldset class="js product-form__input product-form__input--pill">
          <legend class="form__label">
            {{ option.name }}:
            <span data-selected-value>
              {{- option.selected_value -}}
            </span>
          </legend>
          {%- for value in option.values -%}
            <input
              type="radio"
              id="{{ input_id }}"
              name="{{ input_name | escape }}"
              value="{{ value | escape }}"
              form="{{ product_form_id }}"
              {% if value.selected %}
                checked
              {% endif %}
              {% if option_disabled %}
                class="disabled"
              {% endif %}
              {{ input_dataset }}
            >
            <label for="{{ input_id }}">
              {{ value -}}
              {{ label_unavailable }}
            </label>
          {% endfor %}
        </fieldset>
      {% endcapture %}
    {% endif %}
    {% if color_option_names contains option.name %}
      {% capture color_variant_markup %}
        {%- capture input_id -%}
          {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
        {%- endcapture -%}
        {%- capture input_name -%}
          {{ option.name }}-{{ option.position }}
        {%- endcapture -%}
        <fieldset class="js product-form__input product-form__input--pill">
          <legend class="form__label">
            {{ option.name }}:
            <span data-selected-value>
              {{- option.selected_value -}}
            </span>
          </legend>
          {%- for value in option.values -%}
            <input
              type="radio"
              id="{{ input_id }}"
              name="{{ input_name | escape }}"
              value="{{ value | escape }}"
              form="{{ product_form_id }}"
              {% if value.selected %}
                checked
              {% endif %}
              {% if option_disabled %}
                class="disabled"
              {% endif %}
              {{ input_dataset }}
            >
              {{ value | json }}
            <label for="{{ input_id }}" style="--clr:{{ 'rgb(' | append: value.swatch.color.rgb | append: ')' }}">
              {{ value -}}
              {{ label_unavailable }}
            </label>
          {% endfor %}
        </fieldset>
      {% endcapture %}
    {% endif %}
  {% endfor %}

  {{ color_variant_markup }}
  {{ size_variant_markup }}
</ss-variant-picker>
